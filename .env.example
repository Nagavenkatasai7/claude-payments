# SmartRemit environment variables.
#
# Copy to .env.local for local development. Values here are EMPTY or a
# non-secret placeholder; never commit a real value. On Vercel, set values
# with `vercel env add NAME production --value ...` (piped input stores an
# empty value on CLI v54).
#
# Source of truth: src/lib/env.ts (every getter) and src/lib/boot-assert.ts
# (REQUIRED_PRODUCTION_VARS). tests/env-example.test.ts fails CI (`ci / ci`)
# if a name read in env.ts is missing here or a value looks like a secret.
# Platform-injected names (VERCEL_*, NODE_ENV) are not listed.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Boot-blocking (production refuses to boot if any of these is missing or
#    empty — src/lib/boot-assert.ts REQUIRED_PRODUCTION_VARS)
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres pooled connection string — THE ledger. Injected by the Vercel
# Marketplace integration. Missing ⇒ prod refuses to boot.
DATABASE_URL=

# Optional: the direct (unpooled) Neon connection that drizzle-kit migrate uses
# for DDL (drizzle.config.ts). Unset ⇒ drizzle-kit falls back to DATABASE_URL.
# Injected by the Vercel Marketplace integration. Not read by the app.
DATABASE_URL_UNPOOLED=

# Upstash Redis (hot/ephemeral state: sessions, OTPs, drafts, throttles, rate
# limits, FX cache). Injected by the Vercel Marketplace integration.
# Missing ⇒ prod refuses to boot.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Envelope-encryption master key for PII and payout destinations: 64 hex chars
# OR base64 that decodes to exactly 32 bytes. SET-ONCE, NEVER ROTATE: every
# encrypted field depends on it. Missing or malformed ⇒ prod refuses to boot.
FIELD_ENCRYPTION_KEY=

# Which sanctions list the screener uses, never whether screening runs (it
# always runs). Unset or "mock" = the demo watchlist; "ofac-sdn" = the OFAC SDN
# list loaded into Postgres by the daily loader below (while no version is
# loaded, every transfer goes to manual review); any other value = the demo
# watchlist plus a warning. Optional; leave unset in production until the owner
# turns the real list on — and only AFTER a list version has been loaded.
SANCTIONS_LIST=

# "1" or "true" = /api/cron downloads the OFAC SDN list (Treasury Sanctions List
# Service) daily and stores a new version when it changed. Loads the list only;
# it never turns screening on or off. Optional, OFF when unset (production
# default until the owner flips it).
SANCTIONS_LOADER_ENABLED=

# HMAC pepper applied before Argon2id password hashing. SET-ONCE, NEVER
# ROTATE: every stored password hash depends on it.
# Missing ⇒ prod refuses to boot.
PASSWORD_PEPPER=

# Bearer secret for /api/worker and /api/cron (the Vercel cron sends it).
# Missing ⇒ prod refuses to boot.
CRON_SECRET=

# Meta App Secret — verifies X-Hub-Signature-256 on inbound WhatsApp webhooks
# (fail-closed). Missing ⇒ prod refuses to boot.
META_APP_SECRET=

# WhatsApp number (E.164) that receives stuck-money / dead-letter ops alerts.
# Missing ⇒ prod refuses to boot.
OPS_ALERT_PHONE=

# ─────────────────────────────────────────────────────────────────────────────
# 2. App URL
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL for links in messages. Optional: on Vercel it self-derives
# from VERCEL_PROJECT_PRODUCTION_URL, and falls back to https://smartremit.ai.
APP_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 3. WhatsApp (Meta Cloud API) — the platform's default number. Partners may
#    bring their own numbers; those credentials live encrypted in the database.
# ─────────────────────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The token Meta echoes back during the webhook subscription handshake.
WHATSAPP_VERIFY_TOKEN=

# Message templates are OPT-IN: empty ⇒ free-form text is sent instead.
WHATSAPP_AUTH_TEMPLATE=
WHATSAPP_VERIFICATION_NEEDED_TEMPLATE=
WHATSAPP_VERIFICATION_IN_PROGRESS_TEMPLATE=
WHATSAPP_VERIFICATION_VERIFIED_TEMPLATE=
WHATSAPP_VERIFICATION_FAILED_TEMPLATE=
# Program-Fix 25 (optional; empty ⇒ today's behaviour). The approved UTILITY
# template for ops alerts (one body variable); empty ⇒ free-form text.
WHATSAPP_OPS_ALERT_TEMPLATE=
# 'true' ⇒ business-initiated sends respect the 24h window (template outside it,
# no doomed free-form call). Set only once the production number + templates exist.
WHATSAPP_WINDOW_AWARE=
# Program-Fix 25 PR B (optional; empty ⇒ today's landing number). Digits only
# (E.164 without +, 8-15 digits) for every landing-page WhatsApp link + footer.
# NEXT_PUBLIC_* is inlined at BUILD time: redeploy after setting it.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─────────────────────────────────────────────────────────────────────────────
# 4. AI agent (Ollama Cloud, OpenAI-compatible /chat/completions)
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=
# Optional, never read by the app and not in boot-assert (Program-Fix 49B):
# the nightly real-model bot eval (scripts/eval-bot.ts) runs only when this is
# set, and no-ops otherwise. Script-only overrides, both optional:
# EVAL_OLLAMA_BASE_URL (default https://ollama.com/v1) and EVAL_OLLAMA_MODEL.
EVAL_OLLAMA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 5. KYC — Persona. All optional: unset ⇒ the mock KYC provider is used and
#    the Persona webhook rejects (fail-closed).
# ─────────────────────────────────────────────────────────────────────────────
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
PERSONA_INQUIRY_TEMPLATE_VERSION_ID=
PERSONA_ENVIRONMENT=sandbox
PERSONA_API_VERSION=2025-12-08
PERSONA_API_BASE=https://api.withpersona.com/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# 6. Payment / funding webhooks — one HMAC secret per provider, named by the
#    provider (read by env.paymentWebhookSecret / env.fundingWebhookSecret).
#    Unset ⇒ that provider's webhook rejects (fail-closed). Examples:
# ─────────────────────────────────────────────────────────────────────────────
# PAYMENT_WEBHOOK_SECRET_<PROVIDER>=
# Optional rotation grace secret for the same provider (accepted alongside the current one):
# PAYMENT_WEBHOOK_SECRET_<PROVIDER>_PREVIOUS=
# FUNDING_WEBHOOK_SECRET_<PROVIDER>=
# Program-Fix 7 — real sender funds capture through each LICENSED PARTNER's own
# Stripe account (keys live per partner, encrypted, in partner_integrations —
# never here). OPTIONAL, default OFF; never boot-required:
STRIPE_FUNDING_ENABLED=
# Let a Stripe TEST-MODE success settle a transfer (never in production):
STRIPE_FUNDING_ALLOW_TEST_MODE=

# ─────────────────────────────────────────────────────────────────────────────
# 7. File storage — Vercel Blob
# ─────────────────────────────────────────────────────────────────────────────

# PRIVATE store for partner licence / KYB / AML documents. Optional: unset ⇒
# document uploads return a friendly 503; the text application still submits.
PARTNER_DOCS_BLOB_READ_WRITE_TOKEN=

# The OLD public store. No longer receives uploads; kept only for the one-off
# scripts/migrate-partner-docs-private.ts clean-up. Remove once that has run.
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# 8. Email (SMTP, for "Partner with us" lead notifications). All optional:
#    unset ⇒ the email is skipped and the lead still lands in the admin
#    Partner-requests page.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
# The FULL mailbox address; the From address must equal it.
SMTP_USER=
SMTP_PASS=
# Defaults to "SmartRemit <SMTP_USER>".
EMAIL_FROM=
# Comma-separated recipients; a built-in default applies when unset.
PARTNER_LEAD_EMAILS=

# ─────────────────────────────────────────────────────────────────────────────
# 9. Seed accounts (dev, CI and the e2e smoke only)
# ─────────────────────────────────────────────────────────────────────────────
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
# Optional partner-staff seed, for e2e runs that need a partner login.
SEED_PARTNER_USERNAME=
SEED_PARTNER_PASSWORD=
SEED_PARTNER_ID=

# Program-Fix 17b: staff TOTP MFA. Optional; MFA stays opt-in when unset.
# true ⇒ unenrolled platform admins must enrol before platform-admin pages.
# Set STAFF_MFA_EXEMPT (e.g. the e2e smoke account) BEFORE turning this on.
# The seed admin is always exempt from enforcement.
STAFF_MFA_REQUIRED=
# Comma-separated staff usernames exempt from MFA enforcement only.
STAFF_MFA_EXEMPT=

# Program-Fix 49D: customer portal TOTP. Optional; portal MFA stays opt-in when
# unset. true ⇒ refund and recall requests from the portal require two-step
# verification to be on. Enrolled customers always get the code step.
CUSTOMER_MFA_REQUIRED=

# ─────────────────────────────────────────────────────────────────────────────
# 10. Dev flags
# ─────────────────────────────────────────────────────────────────────────────

# true ⇒ OTP codes are logged and the WhatsApp send is skipped. Never in prod.
OTP_DEV_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# 11. Observability (Program-Fix 26). All optional, never boot-blocking:
#     unset ⇒ nothing is sent and ops alerts go to OPS_ALERT_PHONE only.
# ─────────────────────────────────────────────────────────────────────────────

# Sentry DSN (Next.js project). Set ⇒ scrubbed server errors are sent by
# onRequestError in src/instrumentation.ts. Unset or unparseable ⇒ no-op.
SENTRY_DSN=
# Comma-separated mailbox(es) that also get every ops alert by email (needs SMTP
# above). The alert text is scrubbed first.
OPS_ALERT_EMAIL=
# Incoming-webhook URL (Slack/PagerDuty style, JSON {"text": …}) that also gets
# every ops alert. https only; it is a secret. Set it only after the deploy that
# adds the ops.webhook worker kind has reached 100%.
OPS_ALERT_WEBHOOK_URL=
